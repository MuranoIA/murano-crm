# Molde das variáveis de ambiente do app web (Next.js).
#
# Para rodar localmente:  cp .env.example .env.local  → e preencha os valores.
#
# O .env.local NUNCA vai para o git (ver .gitignore da raiz). Este arquivo vai —
# por isso ele não pode conter nenhum valor real, só os nomes.
#
# Em produção estes valores vivem na Vercel → Settings → Environment Variables.
# Os valores do ETL (job da raiz do repo) ficam no .env da raiz e nos Secrets do
# GitHub Actions — arquivos separados, ver .env.example da raiz.

# ---------------------------------------------------------------------------
# Servidor — nunca chegam ao navegador (usadas só em app/api/*)
# ---------------------------------------------------------------------------

# Supabase murano-conversas (ref wtunzezigncwjpcqsfzk).
# A service_role ignora RLS e dá acesso total ao banco: use SOMENTE server-side.
# Nunca prefixe esta chave com NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API do RD Station Conversas (ex-Tallos).
# Token gerado em app.tallos.com.br → Apps e Integrações → API.
RD_CONVERSAS_BASE_URL=https://api.tallos.com.br
RD_CONVERSAS_TOKEN=

# Chave privada (JWK completo, começa com {"kty":"RSA") para descriptografar o
# histórico de mensagens, que a API devolve em JWE.
# ATENÇÃO: clicar em "Gerar Chave" no painel do RD rotaciona a chave sem acumular
# e a privada aparece uma única vez — todo o histórico cifrado com a chave anterior
# fica permanentemente ilegível. Ver CLAUDE.md, seção 3.
RD_CONVERSAS_PRIVATE_JWK=

# LEGADO: id do template de recontato, só usado por /api/send-template se NENHUM
# template da tabela crm_templates estiver marcado como padrão (coluna `padrao`).
# O jeito normal de trocar o template padrão agora é pela UI (Automáticos → ☆),
# sem precisar mexer aqui nem fazer redeploy — ver migration 0076.
TEMPLATE_RECONTATO_ID=

# Segredo compartilhado com o murano-app (hub interno) para a ponte de SSO em
# /auth/hub-sso — o hub embute este CRM num <iframe> em /crm-externo e usa
# este segredo pra assinar (HMAC-SHA256) um token curto provando quem esta
# logado la. MESMO VALOR tem que estar configurado nas duas Vercel (deste
# projeto e do murano-app, var CRM_HUB_SSO_SECRET). Gerar com
# `openssl rand -hex 32` ou equivalente; nao reutilizar outro segredo do
# projeto. Ver CLAUDE.md.
CRM_HUB_SSO_SECRET=

# PAT do GitHub com permissão Actions: write — usado por /api/sync-etl para
# disparar, pausar e retomar os workflows do ETL.
# Opcional em dev: sem ele o botão "Sincronizar agora" responde 500 e o resto do
# app funciona normalmente.
GITHUB_ETL_TOKEN=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — canal direto, substituto do RD Conversas
# Valores em developers.facebook.com → seu app → WhatsApp → Configuração da API.
# ---------------------------------------------------------------------------

# Token de acesso. O do painel ("token temporário") expira em 24h — serve só para
# testar. Em produção, gerar token permanente via Usuário do Sistema no Business
# Manager (Configurações do negócio → Usuários → Usuários do sistema).
WHATSAPP_TOKEN=

# Id do NÚMERO de telefone (campo "Identificação do número de telefone" no painel —
# não é o telefone em si, é um id numérico).
WHATSAPP_PHONE_NUMBER_ID=

# Id da conta do WhatsApp Business (WABA) — usado para gerenciar templates.
WHATSAPP_WABA_ID=

# String secreta INVENTADA POR NÓS, usada uma única vez quando a Meta valida a URL
# do webhook (tem que ser igual aqui e no painel da Meta ao cadastrar o webhook).
WHATSAPP_VERIFY_TOKEN=

# "Chave secreta do aplicativo" (app secret) — em Configurações do app → Básico.
# Usada para validar a assinatura X-Hub-Signature-256 dos eventos do webhook.
# Opcional em dev: sem ela o webhook aceita qualquer origem.
WHATSAPP_APP_SECRET=

# Interruptor da transição de ENVIO: false/ausente = board envia pelo RD (padrão);
# true = board envia pela Cloud API (ligar só na migração do número, Fase C).
# Clientes wa:* (nascidos no canal direto) sempre saem pela Cloud API.
WHATSAPP_ENVIO_PADRAO=

# Nome do template de recontato APROVADO no Gerenciador da Meta (equivalente Cloud
# API do TEMPLATE_RECONTATO_ID do RD). Enquanto vazio, envio de template pelo canal
# direto responde 501.
WHATSAPP_TEMPLATE_RECONTATO=

# ---------------------------------------------------------------------------
# Navegador — públicas por design
# ---------------------------------------------------------------------------

# O prefixo NEXT_PUBLIC_ faz o Next.js embutir o valor no JavaScript enviado ao
# navegador: qualquer visitante consegue ler. Use apenas com a anon key, que é
# pública e protegida por RLS — jamais com a service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
